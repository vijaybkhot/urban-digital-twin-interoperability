# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local environment files may hold Cesium ion or ArcGIS credentials. Ignore every
# .env variant explicitly rather than relying on the broad *.local glob above, and
# keep only the placeholder example tracked (see .env.example and SECURITY.md).
.env
.env.*
!.env.example

# Local reconstruction sample outputs
public/models/*.ply
public/models/*.glb
!public/models/CesiumMilkTruck.glb

# Python tooling caches
__pycache__/
*.pyc

# Raw cached responses from external open-data APIs (regenerate via npm run fetch:urban-resilience-data)
scripts/.cache/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
